#!/bin/bash
# Remove an older RefAB of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "RefAB-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/RefAB.vst3"
elif [ "$(basename "$1")" = "RefAB-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/RefAB.component"
fi
exit 0
